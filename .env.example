# ───────────────────────── HoloHand AI – server configuration ─────────────────────────
# Everything is optional. With nothing set, the app runs fully locally:
# on-device hand tracking, on-device object detection (80 COCO + 1000 ImageNet labels),
# procedural approximate models and the bundled sample GLB catalog.
#
# Keys are only read by the Node server (server/) and are never sent to the browser.

# Which multimodal provider to use: anthropic | openai | gemini | ollama | none
# If empty, the first provider with a key set below is used.
AI_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high – lower is faster/cheaper for recognition
ANTHROPIC_EFFORT=medium

# OpenAI or any OpenAI-compatible endpoint (OpenRouter, Groq, LM Studio, vLLM…)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Thinking level for Gemini 3 models: low (fast, recommended) | medium | high | default
GEMINI_THINKING=low

# Ollama – free, local multimodal models (e.g. `ollama pull llava`)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# Max AI recognition requests per minute per client
AI_REQUESTS_PER_MINUTE=12

# Extra model catalogs (comma-separated URLs of JSON files shaped like public/models/catalog.json).
# Every entry must carry a licence and attribution.
MODEL_CATALOG_URLS=

# API port (the Vite dev server proxies /api to it)
API_PORT=8787
